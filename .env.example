# =============================================================================
# Fish Species API — Environment
# =============================================================================
#
# Docker Compose memakai profile:
#   dev  → local    : docker compose --profile dev up -d --build
#   prod → server   : docker compose --profile prod up -d --build
#
# Set COMPOSE_PROFILES=dev di .env agar `docker compose up` langsung pakai dev.
#
# File env per profile:
#   .env.development          — development (boleh dipakai langsung)
#   .env.production.example   — salin ke .env.production untuk server
# =============================================================================
