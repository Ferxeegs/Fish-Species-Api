# =============================================================================
# Fish Species API — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
LOG_LEVEL=INFO

# --- Security (REQUIRED in production) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
API_KEY=change-me-to-a-strong-api-key

# Comma-separated allowed origins (leave empty to disable CORS)
CORS_ORIGINS=

# --- Model ---
MODEL_PATH=model/speciesv4.pt
SCORE_THRESHOLD=0.4
CLASS_NAMES=Ikan Bawal,Ikan Gurame,Ikan Lele,Ikan Nila,Ikan Tuna

# --- Upload validation ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# --- Rate limiting ---
RATE_LIMIT=30 per minute
# Use redis://host:6379 for multi-instance deployments
RATE_LIMIT_STORAGE_URI=memory://

# --- Gunicorn (production server) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
