# =============================================================================
# Fish Species API — PRODUCTION
# Salin ke .env.production lalu isi SECRET_KEY & API_KEY yang kuat.
# Dipakai oleh: docker compose --profile prod
# =============================================================================

FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
LOG_LEVEL=INFO

# WAJIB diganti di server production
SECRET_KEY=change-me-to-a-random-64-char-hex-string
API_KEY=change-me-to-a-strong-api-key

CORS_ORIGINS=

MODEL_PATH=model/speciesv4.pt
SCORE_THRESHOLD=0.4
CLASS_NAMES=Ikan Bawal,Ikan Gurame,Ikan Lele,Ikan Nila,Ikan Tuna

MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

RATE_LIMIT=30 per minute
RATE_LIMIT_STORAGE_URI=memory://

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

ENABLE_DOCS=true
API_SERVER_URL=https://fish-species.ferxcode.my.id
