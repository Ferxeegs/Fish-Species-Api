# =============================================================================
# Fish Species API — DEVELOPMENT
# Dipakai oleh: docker compose --profile dev
# =============================================================================

FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
LOG_LEVEL=DEBUG

# Development: boleh pakai nilai sederhana (bukan untuk production)
SECRET_KEY=dev-secret-key-change-me
API_KEY=dev-api-key

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MODEL_PATH=model/speciesv4.pt
SCORE_THRESHOLD=0.4
CLASS_NAMES=Ikan Bawal,Ikan Gurame,Ikan Lele,Ikan Nila,Ikan Tuna

MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

RATE_LIMIT=120 per minute
RATE_LIMIT_STORAGE_URI=memory://

GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

ENABLE_DOCS=true
API_SERVER_URL=http://localhost:5000

# Docker Compose — profile default untuk local
COMPOSE_PROFILES=dev
